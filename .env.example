# Dashboard login credentials (required)
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=change-me

# Secret used to sign login tokens (required; generate with: openssl rand -hex 32)
# Keep this stable across restarts — changing it logs everyone out.
JWT_SECRET=change-me

# Port to expose the frontend on the host (default: 3000)
FRONTEND_PORT=3000

# Free Games Notifier
FREE_GAMES_NOTIFIER_URL=http://free-games-notifier:8000
FREE_GAMES_NOTIFIER_API_KEY=
FREE_GAMES_NOTIFIER_TEST_WEBHOOK_URL=

# CaduTrack (used for the summary-url X-API-Key in services.yaml)
CADUTRACK_API_KEY=
